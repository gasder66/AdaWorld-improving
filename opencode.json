{
  "$schema": "https://opencode.ai/config.json",
  "model": "paratera/GLM-5.2",
  "provider": {
    "paratera": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "并行智算云",
      "options": {
        "baseURL": "https://ai.paratera.com/v1",
        "apiKey": "{env:PARATERA_API_KEY}"
      },
      "models": {
        "GLM-5.2": {
          "name": "GLM-5.2",
          "limit": {
            "context": 131072,
            "output": 32768
          }
        }
      }
    }
  },
  "mcp": {
    "lark-mcp": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@larksuiteoapi/lark-mcp",
        "mcp",
        "-a",
        "{env:FEISHU_APP_ID}",
        "-s",
        "{env:FEISHU_APP_SECRET}",
        "-t",
        "preset.doc.default,docx.v1.document.create,docx.v1.document.get,docx.v1.document.convert,docx.v1.documentBlock.list,docx.v1.documentBlock.get,docx.v1.documentBlockChildren.create,docx.v1.documentBlock.patch,docx.v1.documentBlockChildren.batchDelete",
        "-l",
        "zh"
      ],
      "enabled": true
    }
  }
}
